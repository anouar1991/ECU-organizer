    "EDC15V-5.36",
    "EDC16",
    "EDC17",
    "MSA6",
    "MSA11",
    "MSA12",
    "MSA15"
  ],
  "vag_partnumber_format": {
    "description": "VAG OEM engine ECU partnumber. 11 chars: DD L DDDDDD LL (digit digit letter digit*6 letter letter). Used by Tools.IsEDC16Partnumber() to confirm an EDC16 firmware when the ASCII 'EDC  ' block is absent.",
    "regex": "^[0-9]{2}[A-Z][0-9]{6}[A-Z]{2}$",
    "common_prefixes_observed_in_partNumberConverter": ["038906018", "038906019"],
    "extracted_from": "Tools.cs:333-349"
  },
  "bosch_partnumber_format": {
    "description": "Bosch 10-digit partnumber, always starts with '0281' for diesel EDC ECUs. Found near the 'EDC  ' marker or scanned independently when the marker is missing.",
    "regex": "^0281[0-9]{6}$",
    "ascii_prefix_bytes": "30 32 38 31",
    "extracted_from": "Tools.cs:73,81"
  },
